<Window x:Class="Framelock.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Framelock.Ui"
        xmlns:core="clr-namespace:Framelock.Core"
        Title="Framelock" Icon="/Assets/Framelock.ico" Width="1440" Height="900" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg0Brush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ui:BoolToVisibility x:Key="BoolVis" />
        <ui:InverseBool x:Key="Not" />
        <ui:EnumToBool x:Key="EnumBool" />
        <ui:EqualsToVisibility x:Key="EqVis" />
        <ui:NullToVisibility x:Key="NullVis" />
        <ui:Percent x:Key="Pct" />
        <ui:LevelToMeter x:Key="Meter" />
        <ui:DurationText x:Key="Dur" />
        <ui:EnumText x:Key="EnumText" />

        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TabScroll" TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Padding" Value="0,0,10,12" />
        </Style>
        <Style x:Key="Segments" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Bg2Brush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style TargetType="ui:HotkeyBox" BasedOn="{StaticResource {x:Type TextBox}}" />
        <Style x:Key="Toggle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,6,0,2" />
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============================== title bar ============================== -->
            <Grid Grid.Row="0" Background="{StaticResource Bg0Brush}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Grid Width="22" Height="22" Margin="0,0,10,0">
                        <Rectangle RadiusX="6" RadiusY="6" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" />
                        <Ellipse Width="8" Height="8" Fill="{StaticResource RecBrush}" />
                    </Grid>
                    <TextBlock Text="Framelock" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                    <Border Margin="14,0,0,0" CornerRadius="11" Padding="10,3" VerticalAlignment="Center" Background="{StaticResource Bg2Brush}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center" Fill="{StaticResource GoodBrush}" />
                            <TextBlock x:Name="StatusText" Text="{Binding Rec.StatusText}" FontSize="12" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"
                                       MaxWidth="520" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleBarButton}" ToolTip="Open recordings folder" Command="{Binding OpenFolderCommand}">
                        <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE838;" />
                    </Button>
                    <Button Style="{StaticResource TitleBarButton}" ToolTip="Hide to tray" Click="HideToTray_Click">
                        <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE73F;" />
                    </Button>
                    <Button Style="{StaticResource TitleBarButton}" Click="Minimize_Click">
                        <TextBlock Style="{StaticResource Icon}" FontSize="10" Text="&#xE921;" />
                    </Button>
                    <Button Style="{StaticResource TitleBarButton}" Click="Maximize_Click">
                        <TextBlock x:Name="MaxGlyph" Style="{StaticResource Icon}" FontSize="10" Text="&#xE922;" />
                    </Button>
                    <Button Style="{StaticResource TitleBarCloseButton}" Click="Close_Click">
                        <TextBlock Style="{StaticResource Icon}" FontSize="10" Text="&#xE8BB;" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ============================== body ============================== -->
            <Grid Grid.Row="1" Margin="16,4,16,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="430" />
                </Grid.ColumnDefinitions>

                <!-- ============ left: source / preview / controls ============ -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- source bar -->
                    <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,12" IsEnabled="{Binding Rec.IsBusy, Converter={StaticResource Not}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Segments}" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource SegmentedRadio}" GroupName="Src" ToolTip="Record a whole display"
                                                 IsChecked="{Binding S.SourceKind, Converter={StaticResource EnumBool}, ConverterParameter=Display}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE7F4;" Margin="0,0,7,0" />
                                            <TextBlock Text="Display" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource SegmentedRadio}" GroupName="Src" ToolTip="Record one window or game (follows it when it moves)"
                                                 IsChecked="{Binding S.SourceKind, Converter={StaticResource EnumBool}, ConverterParameter=Window}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE7C4;" Margin="0,0,7,0" />
                                            <TextBlock Text="Window" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource SegmentedRadio}" GroupName="Src" ToolTip="Record a rectangle of the screen"
                                                 IsChecked="{Binding S.SourceKind, Converter={StaticResource EnumBool}, ConverterParameter=Region}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE7A8;" Margin="0,0,7,0" />
                                            <TextBlock Text="Region" />
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </Border>

                            <!-- display picker -->
                            <ComboBox Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                      Visibility="{Binding S.SourceKind, Converter={StaticResource EqVis}, ConverterParameter=Display}"
                                      ItemsSource="{Binding Displays}" SelectedValuePath="DeviceName" SelectedValue="{Binding S.DisplayId}"
                                      DropDownOpened="Displays_DropDownOpened" />

                            <!-- window picker -->
                            <Grid Grid.Column="1" Margin="12,0,0,0" Visibility="{Binding S.SourceKind, Converter={StaticResource EqVis}, ConverterParameter=Window}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding Windows}" SelectedItem="{Binding SelectedWindow}" DropDownOpened="Windows_DropDownOpened"
                                          VerticalAlignment="Center" MaxDropDownHeight="480">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Title}" MaxWidth="340" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding ExeName}" Margin="8,0,0,0" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding SizeLabel}" Margin="8,0,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <CheckBox Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Content="Client area only"
                                          ToolTip="Skip the title bar and borders (recommended for games)" IsChecked="{Binding S.WindowClientOnly}" />
                            </Grid>

                            <!-- region picker -->
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" Orientation="Horizontal"
                                        Visibility="{Binding S.SourceKind, Converter={StaticResource EqVis}, ConverterParameter=Region}">
                                <Button Style="{StaticResource PrimaryButton}" Padding="12,6" Click="SelectRegion_Click" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE7A8;" Margin="0,0,8,0" />
                                        <TextBlock Text="Select region" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}" Text="{Binding SourceSummary}" />
                            </StackPanel>

                            <CheckBox Grid.Column="2" Margin="12,0,4,0" VerticalAlignment="Center" Content="Cursor" ToolTip="Show the mouse cursor in the recording"
                                      IsChecked="{Binding S.CaptureCursor}" />
                        </Grid>
                    </Border>

                    <!-- preview -->
                    <Border Grid.Row="1" CornerRadius="10" Background="#08090B" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" ClipToBounds="True">
                        <Grid x:Name="PreviewHost">
                            <Viewbox x:Name="PreviewBox" Stretch="Uniform" Margin="10">
                                <Grid x:Name="PreviewSurface" Width="1920" Height="1080" Background="Black">
                                    <Image x:Name="PreviewImage" Stretch="Fill" RenderOptions.BitmapScalingMode="Linear" />
                                    <Canvas x:Name="OverlayCanvas" Background="Transparent"
                                            MouseLeftButtonDown="OverlayCanvas_MouseDown" MouseMove="OverlayCanvas_MouseMove"
                                            MouseLeftButtonUp="OverlayCanvas_MouseUp" MouseLeave="OverlayCanvas_MouseLeave">
                                        <Border x:Name="OverlaySelection" BorderBrush="{StaticResource AccentBrush}" BorderThickness="3" Visibility="Collapsed" IsHitTestVisible="False">
                                            <Border.Background>
                                                <SolidColorBrush Color="{StaticResource Accent}" Opacity="0.08" />
                                            </Border.Background>
                                        </Border>
                                        <Rectangle x:Name="OverlayHandle" Fill="{StaticResource AccentBrush}" Width="16" Height="16" Visibility="Collapsed" Cursor="SizeNWSE" />
                                        <Line x:Name="SnapGuideV" Stroke="{StaticResource WarnBrush}" StrokeThickness="2" StrokeDashArray="4 3" Visibility="Collapsed" IsHitTestVisible="False" />
                                        <Line x:Name="SnapGuideH" Stroke="{StaticResource WarnBrush}" StrokeThickness="2" StrokeDashArray="4 3" Visibility="Collapsed" IsHitTestVisible="False" />
                                    </Canvas>
                                </Grid>
                            </Viewbox>

                            <!-- no preview placeholder -->
                            <StackPanel x:Name="PreviewPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource Icon}" FontSize="36" Text="&#xE7F4;" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock x:Name="PreviewPlaceholderText" Margin="0,12,0,0" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center" TextAlignment="Center"
                                           Text="Pick something to record" />
                            </StackPanel>

                            <!-- badges -->
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18" CornerRadius="6" Padding="9,4" Background="#B30D0E12">
                                <TextBlock FontSize="12" Foreground="{StaticResource TextDimBrush}">
                                    <Run Text="{Binding Rec.OutputInfo, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="18" CornerRadius="6" Padding="9,4" Background="#B30D0E12"
                                    Visibility="{Binding StatsText, Converter={StaticResource NullVis}}">
                                <TextBlock FontSize="12" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource TextDimBrush}" Text="{Binding StatsText}" />
                            </Border>
                            <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="18" CornerRadius="6" Padding="10,5" Background="#D90D0E12"
                                    x:Name="OverlayHint" Visibility="Collapsed">
                                <TextBlock FontSize="12" Foreground="{StaticResource TextDimBrush}" Text="Drag overlays to move them · drag the corner to resize · Shift disables snapping" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- record controls -->
                    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- record / stop -->
                                <Button x:Name="RecordButton" Width="56" Height="56" Command="{Binding RecordCommand}" Cursor="Hand" ToolTip="Start / stop recording">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid>
                                                <Ellipse x:Name="Ring" Stroke="{StaticResource Bg4Brush}" StrokeThickness="3" Fill="{StaticResource Bg2Brush}" />
                                                <Ellipse x:Name="Dot" Width="24" Height="24" Fill="{StaticResource RecBrush}" />
                                                <Rectangle x:Name="Square" Width="20" Height="20" RadiusX="4" RadiusY="4" Fill="{StaticResource RecBrush}" Visibility="Collapsed" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource RecBrush}" />
                                                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource RecHoverBrush}" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding Rec.IsRecording}" Value="True">
                                                    <Setter TargetName="Dot" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="Square" Property="Visibility" Value="Visible" />
                                                    <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource RecBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Rec.IsBusy}" Value="True">
                                                    <Setter Property="Opacity" Value="0.6" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Width="40" Height="40" Margin="10,0,0,0" Command="{Binding PauseCommand}" ToolTip="Pause / resume">
                                    <Grid>
                                        <TextBlock Style="{StaticResource Icon}" FontSize="18" Text="&#xE769;" Visibility="{Binding Rec.IsPaused, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />
                                        <TextBlock Style="{StaticResource Icon}" FontSize="18" Text="&#xE768;" Visibility="{Binding Rec.IsPaused, Converter={StaticResource BoolVis}}" />
                                    </Grid>
                                </Button>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TimerText" FontFamily="Cascadia Mono, Consolas" FontSize="26" FontWeight="SemiBold"
                                           Text="{Binding Rec.Elapsed, Converter={StaticResource Dur}}" />
                                <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}">
                                    <Run Text="{Binding Rec.FileSize, Mode=OneWay}" />
                                    <Run Text="{Binding OutputSummary, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>

                            <!-- mini meters -->
                            <Grid Grid.Column="2" Margin="24,0,12,0" VerticalAlignment="Center" MaxWidth="260" HorizontalAlignment="Left" MinWidth="140">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource Icon}" FontSize="13" Text="&#xE767;" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0" ToolTip="Desktop audio" />
                                <ProgressBar Grid.Column="1" Style="{StaticResource MeterBar}" Value="{Binding DesktopLevel, Converter={StaticResource Meter}, Mode=OneWay}" />
                                <ToggleButton Grid.Row="1" Margin="0,6,8,0" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                              IsChecked="{Binding S.MicMuted}" ToolTip="Mute / unmute microphone">
                                    <Grid>
                                        <TextBlock Style="{StaticResource Icon}" FontSize="13" Text="&#xE720;" Foreground="{StaticResource TextMutedBrush}"
                                                   Visibility="{Binding S.MicMuted, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />
                                        <TextBlock Style="{StaticResource Icon}" FontSize="13" Text="&#xEC54;" Foreground="{StaticResource RecBrush}"
                                                   Visibility="{Binding S.MicMuted, Converter={StaticResource BoolVis}}" />
                                    </Grid>
                                </ToggleButton>
                                <ProgressBar Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" Style="{StaticResource MeterBar}" Value="{Binding MicLevel, Converter={StaticResource Meter}, Mode=OneWay}" />
                            </Grid>

                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource IconButton}" Width="40" Height="40" Command="{Binding MarkerCommand}" ToolTip="Add a marker (becomes a chapter)">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7C1;" />
                                </Button>
                                <Button Style="{StaticResource IconButton}" Width="40" Height="40" Margin="4,0,0,0" Command="{Binding ScreenshotCommand}" ToolTip="Screenshot (PNG, with overlays)">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE722;" />
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0" Padding="12,8" Command="{Binding SaveReplayCommand}"
                                        Visibility="{Binding Rec.ReplayActive, Converter={StaticResource BoolVis}}" ToolTip="{Binding Rec.ReplayInfo}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE81C;" Margin="0,0,8,0" Foreground="{StaticResource GoodBrush}" />
                                        <TextBlock Text="Save replay" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ============ right: settings ============ -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,12,4,0">
                    <TabControl x:Name="SettingsTabs" SelectionChanged="SettingsTabs_SelectionChanged">

                        <!-- ===================== OUTPUT ===================== -->
                        <TabItem Header="Output">
                            <ScrollViewer Style="{StaticResource TabScroll}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionHeader}" Text="QUICK PRESETS" Margin="0,0,0,6" />
                                    <ItemsControl ItemsSource="{Binding QuickPresets}" IsEnabled="{Binding Rec.CanEditPipelineSettings}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource GhostButton}" Margin="0,0,6,6" Padding="10,6" Content="{Binding Name}" ToolTip="{Binding Description}"
                                                        Command="{Binding DataContext.ApplyQuickPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <StackPanel IsEnabled="{Binding Rec.CanEditPipelineSettings}">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Output resolution" />
                                        <ComboBox ItemsSource="{Binding Resolutions}" SelectedItem="{Binding SelectedResolution}" MaxDropDownHeight="520" />
                                        <Grid Margin="0,8,0,0" Visibility="{Binding IsCustomResolution, Converter={StaticResource BoolVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding CustomWidth, UpdateSourceTrigger=LostFocus}" ToolTip="Width (even number)" />
                                            <TextBlock Grid.Column="1" Text="×" Margin="10,0" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBox Grid.Column="2" Text="{Binding CustomHeight, UpdateSourceTrigger=LostFocus}" ToolTip="Height (even number)" />
                                        </Grid>
                                        <TextBlock Style="{StaticResource Hint}" Text="The video is always exactly this size. The picture is scaled to fit - perfect for YouTube." />

                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Frame rate" />
                                        <ComboBox ItemsSource="{Binding FrameRates}" SelectedItem="{Binding S.Fps}" ItemStringFormat="{}{0} fps" />

                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Fit" />
                                        <Border Style="{StaticResource Segments}">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton Style="{StaticResource SegmentedRadio}" GroupName="Fit" Content="Fit" ToolTip="Whole picture, bars if the shape differs"
                                                             IsChecked="{Binding S.ScaleMode, Converter={StaticResource EnumBool}, ConverterParameter=Fit}" />
                                                <RadioButton Style="{StaticResource SegmentedRadio}" GroupName="Fit" Content="Fill" ToolTip="Fill the frame, crop the edges"
                                                             IsChecked="{Binding S.ScaleMode, Converter={StaticResource EnumBool}, ConverterParameter=Fill}" />
                                                <RadioButton Style="{StaticResource SegmentedRadio}" GroupName="Fit" Content="Stretch" ToolTip="Distort to fill exactly"
                                                             IsChecked="{Binding S.ScaleMode, Converter={StaticResource EnumBool}, ConverterParameter=Stretch}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Scaling filter" />
                                    <ComboBox ItemsSource="{Binding ScaleFilters}" SelectedItem="{Binding S.ScaleFilter}" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Auto picks Lanczos when upscaling and area-averaging when downscaling (sharpest, no shimmer)." />

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Bar colour (Fit mode)" />
                                    <TextBox Text="{Binding S.BackgroundColor, UpdateSourceTrigger=LostFocus}" ToolTip="Hex colour, e.g. #000000" />

                                    <TextBlock Style="{StaticResource SectionHeader}" Text="HDR" />
                                    <CheckBox Style="{StaticResource Toggle}" Content="Tone-map HDR displays to SDR"
                                              IsChecked="{Binding S.HdrMode, Converter={StaticResource EnumBool}, ConverterParameter=Auto}" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Keeps HDR games from looking washed out. Uses your Windows 'SDR content brightness' as reference white." />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ===================== ENCODER ===================== -->
                        <TabItem Header="Encoder">
                            <ScrollViewer Style="{StaticResource TabScroll}">
                                <StackPanel IsEnabled="{Binding Rec.CanEditPipelineSettings}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Video encoder" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding Encoders}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedEncoder}" />
                                    <Border Margin="0,8,0,0" CornerRadius="6" Padding="10,7" Background="#1FFBBF24" Visibility="{Binding EncoderWarning, Converter={StaticResource NullVis}}">
                                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource WarnBrush}" Text="{Binding EncoderWarning}" />
                                    </Border>
                                    <TextBlock Style="{StaticResource Hint}" Text="Hardware encoders (NVENC / AMF / Quick Sync) cost games almost nothing. HEVC and AV1 give the best quality per MB; YouTube accepts all of them." />

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Rate control" />
                                    <Border Style="{StaticResource Segments}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource SegmentedRadio}" GroupName="Rc" Content="Quality" ToolTip="Constant quality - best for recordings"
                                                         IsChecked="{Binding S.RateControl, Converter={StaticResource EnumBool}, ConverterParameter=ConstantQuality}" />
                                            <RadioButton Style="{StaticResource SegmentedRadio}" GroupName="Rc" Content="VBR" ToolTip="Variable bitrate around a target"
                                                         IsChecked="{Binding S.RateControl, Converter={StaticResource EnumBool}, ConverterParameter=Vbr}" />
                                            <RadioButton Style="{StaticResource SegmentedRadio}" GroupName="Rc" Content="CBR" ToolTip="Constant bitrate - predictable file size"
                                                         IsChecked="{Binding S.RateControl, Converter={StaticResource EnumBool}, ConverterParameter=Cbr}" />
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Visibility="{Binding S.RateControl, Converter={StaticResource EqVis}, ConverterParameter=ConstantQuality}">
                                        <Grid Margin="0,12,0,4">
                                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0" Text="Quality" />
                                            <TextBlock Style="{StaticResource ValueText}">
                                                <Run Text="{Binding QualityLabel, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding S.Quality, Mode=OneWay}" />
                                            </TextBlock>
                                        </Grid>
                                        <Slider Minimum="12" Maximum="34" Value="{Binding S.Quality}" IsSnapToTickEnabled="True" TickFrequency="1" IsDirectionReversed="True" />
                                        <TextBlock Style="{StaticResource Hint}" Text="Lower number = better picture, bigger files. 18-22 is visually lossless for YouTube uploads." />
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding S.RateControl, Converter={StaticResource EqVis}, ConverterParameter=!ConstantQuality}">
                                        <Grid Margin="0,12,0,4">
                                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0" Text="Bitrate" />
                                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding S.BitrateMbps, StringFormat={}{0} Mbps}" />
                                        </Grid>
                                        <Slider Minimum="5" Maximum="400" Value="{Binding S.BitrateMbps}" IsSnapToTickEnabled="True" TickFrequency="1" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Style="{StaticResource Hint}" Margin="0" VerticalAlignment="Center" Text="{Binding SuggestedBitrateText}" />
                                            <Button Style="{StaticResource GhostButton}" Padding="8,3" Margin="8,0,0,0" FontSize="11" Content="Use" Command="{Binding UseSuggestedBitrateCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Hint}" Text="{Binding EstimatedSize}" />

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Encoder effort" />
                                    <Border Style="{StaticResource Segments}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource SegmentedRadio}" GroupName="Sp" Content="Fastest" IsChecked="{Binding S.SpeedPreset, Converter={StaticResource EnumBool}, ConverterParameter=Performance}" />
                                            <RadioButton Style="{StaticResource SegmentedRadio}" GroupName="Sp" Content="Balanced" IsChecked="{Binding S.SpeedPreset, Converter={StaticResource EnumBool}, ConverterParameter=Balanced}" />
                                            <RadioButton Style="{StaticResource SegmentedRadio}" GroupName="Sp" Content="Quality" IsChecked="{Binding S.SpeedPreset, Converter={StaticResource EnumBool}, ConverterParameter=Quality}" />
                                            <RadioButton Style="{StaticResource SegmentedRadio}" GroupName="Sp" Content="Max" IsChecked="{Binding S.SpeedPreset, Converter={StaticResource EnumBool}, ConverterParameter=MaxQuality}" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Style="{StaticResource Hint}" Text="On a GPU encoder this uses the video engine, not your game's frames. Drop to Fastest if you see skipped frames." />

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Keyframe interval" />
                                    <ComboBox ItemsSource="{Binding KeyframeChoices}" SelectedItem="{Binding S.KeyframeSeconds}" ItemStringFormat="{}Every {0} s" />
                                    <CheckBox Style="{StaticResource Toggle}" Content="B-frames (better compression)" IsChecked="{Binding S.BFrames}" />

                                    <TextBlock Style="{StaticResource SectionHeader}" Text="FILE" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="Container" />
                                    <Border Style="{StaticResource Segments}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource SegmentedRadio}" GroupName="Ct" Content="MP4" IsChecked="{Binding S.Container, Converter={StaticResource EnumBool}, ConverterParameter=Mp4}" />
                                            <RadioButton Style="{StaticResource SegmentedRadio}" GroupName="Ct" Content="MKV" IsChecked="{Binding S.Container, Converter={StaticResource EnumBool}, ConverterParameter=Mkv}" />
                                            <RadioButton Style="{StaticResource SegmentedRadio}" GroupName="Ct" Content="MOV" IsChecked="{Binding S.Container, Converter={StaticResource EnumBool}, ConverterParameter=Mov}" />
                                        </StackPanel>
                                    </Border>
                                    <CheckBox Style="{StaticResource Toggle}" Margin="0,10,0,2" Content="Crash-safe recording" IsChecked="{Binding S.CrashSafe}" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Writes MKV while recording (nothing is lost if the PC crashes), then converts to MP4/MOV in seconds when you stop." />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ===================== AUDIO ===================== -->
                        <TabItem Header="Audio">
                            <ScrollViewer Style="{StaticResource TabScroll}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Style="{StaticResource SectionHeader}" Margin="0,4,0,0" Text="DESKTOP / GAME AUDIO" />
                                        <CheckBox HorizontalAlignment="Right" IsChecked="{Binding S.DesktopAudioEnabled}" />
                                    </Grid>
                                    <StackPanel IsEnabled="{Binding S.DesktopAudioEnabled}">
                                        <ComboBox ItemsSource="{Binding DesktopModes}" SelectedItem="{Binding S.DesktopAudioMode}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock>
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Everything you hear" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding}" Value="{x:Static core:DesktopAudioMode.SpecificDevice}">
                                                                        <Setter Property="Text" Value="A specific output device" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding}" Value="{x:Static core:DesktopAudioMode.CapturedApp}">
                                                                        <Setter Property="Text" Value="Only the recorded window's app" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding}" Value="{x:Static core:DesktopAudioMode.SpecificApp}">
                                                                        <Setter Property="Text" Value="Only one app (e.g. the game)" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding}" Value="{x:Static core:DesktopAudioMode.ExcludeApp}">
                                                                        <Setter Property="Text" Value="Everything except one app (e.g. Discord / Spotify)" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <ComboBox Margin="0,8,0,0" ItemsSource="{Binding RenderDevices}" SelectedValuePath="Id" SelectedValue="{Binding DesktopDeviceId}"
                                                  Visibility="{Binding S.DesktopAudioMode, Converter={StaticResource EqVis}, ConverterParameter=SpecificDevice}" DropDownOpened="AudioDevices_DropDownOpened" />
                                        <ComboBox Margin="0,8,0,0" ItemsSource="{Binding AudioApps}" Text="{Binding S.DesktopAppExe, UpdateSourceTrigger=LostFocus}" IsEditable="True"
                                                  Visibility="{Binding S.DesktopAudioMode, Converter={StaticResource EqVis}, ConverterParameter=SpecificApp|ExcludeApp}" DropDownOpened="AudioDevices_DropDownOpened"
                                                  ToolTip="Pick a running app or type its .exe name" />
                                        <TextBlock Style="{StaticResource Hint}" Text="Framelock's own sounds are never recorded." />
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="44" />
                                            </Grid.ColumnDefinitions>
                                            <ToggleButton Padding="0" Width="28" Height="28" Background="Transparent" BorderThickness="0" IsChecked="{Binding S.DesktopMuted}" ToolTip="Mute">
                                                <Grid>
                                                    <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE767;" Visibility="{Binding S.DesktopMuted, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />
                                                    <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE74F;" Foreground="{StaticResource RecBrush}" Visibility="{Binding S.DesktopMuted, Converter={StaticResource BoolVis}}" />
                                                </Grid>
                                            </ToggleButton>
                                            <Slider Grid.Column="1" Margin="8,0" Minimum="0" Maximum="2" Value="{Binding S.DesktopVolume}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Style="{StaticResource ValueText}" VerticalAlignment="Center" Text="{Binding S.DesktopVolume, Converter={StaticResource Pct}}" />
                                        </Grid>
                                        <ProgressBar Margin="36,6,52,0" Style="{StaticResource MeterBar}" Value="{Binding DesktopLevel, Converter={StaticResource Meter}, Mode=OneWay}" />
                                        <TextBlock Style="{StaticResource Hint}" Margin="36,4,0,0" Text="{Binding DesktopStatus}" />
                                    </StackPanel>

                                    <Grid Margin="0,16,0,4">
                                        <TextBlock Style="{StaticResource SectionHeader}" Margin="0,4,0,0" Text="MICROPHONE" />
                                        <CheckBox HorizontalAlignment="Right" IsChecked="{Binding S.MicEnabled}" />
                                    </Grid>
                                    <StackPanel IsEnabled="{Binding S.MicEnabled}">
                                        <ComboBox ItemsSource="{Binding CaptureDevices}" SelectedValuePath="Id" SelectedValue="{Binding MicDeviceId}" DropDownOpened="AudioDevices_DropDownOpened" />
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="44" />
                                            </Grid.ColumnDefinitions>
                                            <ToggleButton Padding="0" Width="28" Height="28" Background="Transparent" BorderThickness="0" IsChecked="{Binding S.MicMuted}" ToolTip="Mute">
                                                <Grid>
                                                    <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE720;" Visibility="{Binding S.MicMuted, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />
                                                    <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xEC54;" Foreground="{StaticResource RecBrush}" Visibility="{Binding S.MicMuted, Converter={StaticResource BoolVis}}" />
                                                </Grid>
                                            </ToggleButton>
                                            <Slider Grid.Column="1" Margin="8,0" Minimum="0" Maximum="3" Value="{Binding S.MicVolume}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Style="{StaticResource ValueText}" VerticalAlignment="Center" Text="{Binding S.MicVolume, Converter={StaticResource Pct}}" />
                                        </Grid>
                                        <ProgressBar Margin="36,6,52,0" Style="{StaticResource MeterBar}" Value="{Binding MicLevel, Converter={StaticResource Meter}, Mode=OneWay}" />
                                        <TextBlock Style="{StaticResource Hint}" Margin="36,4,0,0" Text="{Binding MicStatus}" />

                                        <CheckBox Style="{StaticResource Toggle}" Margin="0,12,0,2" Content="Noise gate (silence background noise)" IsChecked="{Binding S.MicNoiseGate}" />
                                        <Grid Visibility="{Binding S.MicNoiseGate, Converter={StaticResource BoolVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="64" />
                                            </Grid.ColumnDefinitions>
                                            <Slider Minimum="-70" Maximum="-20" Value="{Binding S.MicGateDb}" IsSnapToTickEnabled="True" TickFrequency="1" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource ValueText}" VerticalAlignment="Center" Text="{Binding S.MicGateDb, StringFormat={}{0} dB}" />
                                        </Grid>
                                        <CheckBox Style="{StaticResource Toggle}" Content="Windows voice processing (echo cancel)" IsChecked="{Binding S.MicVoiceProcessing}"
                                                  ToolTip="Uses the communications mode of your mic driver: echo cancellation and noise suppression when supported." />
                                        <CheckBox Style="{StaticResource Toggle}" Content="Push-to-talk" IsChecked="{Binding S.MicPushToTalk}" />
                                        <Grid Visibility="{Binding S.MicPushToTalk, Converter={StaticResource BoolVis}}" Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Hold key" VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}" Margin="0,0,10,0" />
                                            <ui:HotkeyBox Grid.Column="1" AllowBareKeys="True" Hotkey="{Binding S.PushToTalkKey}" />
                                        </Grid>
                                        <Grid Margin="0,12,0,4">
                                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0" Text="Mic sync offset" />
                                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding S.MicSyncOffsetMs, StringFormat={}{0} ms}" />
                                        </Grid>
                                        <Slider Minimum="-300" Maximum="300" Value="{Binding S.MicSyncOffsetMs}" IsSnapToTickEnabled="True" TickFrequency="5" />
                                        <TextBlock Style="{StaticResource Hint}" Text="Positive delays your voice. Only needed for Bluetooth / USB mics with lag." />
                                    </StackPanel>

                                    <TextBlock Style="{StaticResource SectionHeader}" Margin="0,18,0,6" Text="TRACKS" />
                                    <StackPanel IsEnabled="{Binding Rec.CanEditPipelineSettings}">
                                        <CheckBox Style="{StaticResource Toggle}" Content="Separate tracks (mix · game · mic)" IsChecked="{Binding S.SeparateAudioTracks}" />
                                        <TextBlock Style="{StaticResource Hint}" Text="Track 1 is the full mix (what YouTube plays). Tracks 2 and 3 let you fix levels in your editor later." />
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Audio quality (AAC)" />
                                        <ComboBox ItemsSource="{Binding AudioBitrates}" SelectedItem="{Binding S.AudioBitrateKbps}" ItemStringFormat="{}{0} kbps" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ===================== OVERLAYS ===================== -->
                        <TabItem Header="Overlays">
                            <ScrollViewer Style="{StaticResource TabScroll}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource PrimaryButton}" Padding="12,6" Command="{Binding AddImageOverlayCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xEB9F;" Margin="0,0,8,0" />
                                                <TextBlock Text="Add image" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource GhostButton}" Padding="12,6" Margin="8,0,0,0" Command="{Binding AddTextOverlayCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE8D2;" Margin="0,0,8,0" />
                                                <TextBlock Text="Add text" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Hint}" Text="Logos, watermarks, your @handle. PNG transparency is kept. Drag them around right on the preview." />

                                    <Border Margin="0,14,0,0" Padding="18,22" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource StrokeBrush}" Background="{StaticResource Bg1Brush}"
                                            Visibility="{Binding S.Overlays.Count, Converter={StaticResource EqVis}, ConverterParameter=0}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Style="{StaticResource Icon}" FontSize="28" Text="&#xE91B;" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" FontWeight="SemiBold" Text="No overlays yet" />
                                            <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="300"
                                                       Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                                                       Text="Add a logo or a text watermark like &quot;Follow @you&quot;. Overlays are burned into the video at full output resolution." />
                                        </StackPanel>
                                    </Border>

                                    <ListBox Margin="0,10,0,0" ItemsSource="{Binding S.Overlays}" SelectedItem="{Binding SelectedOverlay}" MaxHeight="220"
                                             Visibility="{Binding S.Overlays.Count, Converter={StaticResource EqVis}, ConverterParameter=!0}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding Visible}" VerticalAlignment="Center" ToolTip="Show / hide" Margin="0,0,8,0" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock FontSize="11" Foreground="{StaticResource RecBrush}" Text="{Binding LoadError}" TextTrimming="CharacterEllipsis"
                                                                   Visibility="{Binding LoadError, Converter={StaticResource NullVis}}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Text="{Binding Kind}" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding SelectedOverlay, Converter={StaticResource NullVis}}">
                                        <Button Style="{StaticResource IconButton}" ToolTip="Move up (draw below)" Command="{Binding MoveOverlayUpCommand}">
                                            <TextBlock Style="{StaticResource Icon}" FontSize="13" Text="&#xE74A;" />
                                        </Button>
                                        <Button Style="{StaticResource IconButton}" ToolTip="Move down (draw on top)" Command="{Binding MoveOverlayDownCommand}">
                                            <TextBlock Style="{StaticResource Icon}" FontSize="13" Text="&#xE74B;" />
                                        </Button>
                                        <Button Style="{StaticResource IconButton}" ToolTip="Duplicate" Command="{Binding DuplicateOverlayCommand}">
                                            <TextBlock Style="{StaticResource Icon}" FontSize="13" Text="&#xE8C8;" />
                                        </Button>
                                        <Button Style="{StaticResource IconButton}" ToolTip="Delete" Command="{Binding RemoveOverlayCommand}">
                                            <TextBlock Style="{StaticResource Icon}" FontSize="13" Text="&#xE74D;" Foreground="{StaticResource RecBrush}" />
                                        </Button>
                                    </StackPanel>

                                    <!-- selected overlay editor -->
                                    <StackPanel DataContext="{Binding SelectedOverlay}" Visibility="{Binding Converter={StaticResource NullVis}}">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Name" />
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                                        <!-- image -->
                                        <StackPanel Visibility="{Binding Kind, Converter={StaticResource EqVis}, ConverterParameter=Image}">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Image" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding ImagePath, Mode=OneWay}" IsReadOnly="True" />
                                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Padding="10,6" Content="Change…"
                                                        Command="{Binding DataContext.BrowseOverlayImageCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            </Grid>
                                        </StackPanel>

                                        <!-- text -->
                                        <StackPanel Visibility="{Binding Kind, Converter={StaticResource EqVis}, ConverterParameter=Text}">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Text" />
                                            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged, Delay=250}" AcceptsReturn="True" MinHeight="34" />
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Font" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ComboBox ItemsSource="{Binding DataContext.FontFamilies, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding FontFamily}"
                                                          MaxDropDownHeight="400" VirtualizingPanel.IsVirtualizing="True">
                                                    <ComboBox.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <VirtualizingStackPanel />
                                                        </ItemsPanelTemplate>
                                                    </ComboBox.ItemsPanel>
                                                </ComboBox>
                                                <ToggleButton Grid.Column="1" Margin="6,0,0,0" Width="34" Padding="0" FontWeight="Bold" Content="B" ToolTip="Bold" IsChecked="{Binding Bold}" />
                                                <ToggleButton Grid.Column="2" Margin="6,0,0,0" Width="34" Padding="0" FontStyle="Italic" Content="I" ToolTip="Italic" IsChecked="{Binding Italic}" />
                                            </Grid>
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="Colour" />
                                                    <TextBox Text="{Binding TextColor, UpdateSourceTrigger=LostFocus}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="Outline" />
                                                    <TextBox Text="{Binding OutlineColor, UpdateSourceTrigger=LostFocus}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="4">
                                                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="Box" ToolTip="Background box colour (#AARRGGBB, 00 alpha = none)" />
                                                    <TextBox Text="{Binding TextBackground, UpdateSourceTrigger=LostFocus}" />
                                                </StackPanel>
                                            </Grid>
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Outline width" VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}" Margin="0,0,10,0" />
                                                <Slider Grid.Column="1" Minimum="0" Maximum="0.25" Value="{Binding OutlineWidth, Delay=150}" />
                                            </Grid>
                                            <CheckBox Style="{StaticResource Toggle}" Content="Drop shadow" IsChecked="{Binding Shadow}" />
                                        </StackPanel>

                                        <TextBlock Style="{StaticResource SectionHeader}" Text="POSITION" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <!-- 3x3 anchor picker -->
                                            <Border Background="{StaticResource Bg2Brush}" CornerRadius="8" Padding="4" VerticalAlignment="Top">
                                                <UniformGrid Rows="3" Columns="3" Width="96" Height="66">
                                                    <UniformGrid.Resources>
                                                        <Style TargetType="RadioButton" BasedOn="{StaticResource SegmentedRadio}">
                                                            <Setter Property="Padding" Value="0" />
                                                            <Setter Property="Margin" Value="1" />
                                                            <Setter Property="GroupName" Value="Anchor" />
                                                        </Style>
                                                    </UniformGrid.Resources>
                                                    <RadioButton ToolTip="Top left" IsChecked="{Binding Anchor, Converter={StaticResource EnumBool}, ConverterParameter=TopLeft}"><Ellipse Width="6" Height="6" Fill="{StaticResource TextDimBrush}" /></RadioButton>
                                                    <RadioButton ToolTip="Top" IsChecked="{Binding Anchor, Converter={StaticResource EnumBool}, ConverterParameter=TopCenter}"><Ellipse Width="6" Height="6" Fill="{StaticResource TextDimBrush}" /></RadioButton>
                                                    <RadioButton ToolTip="Top right" IsChecked="{Binding Anchor, Converter={StaticResource EnumBool}, ConverterParameter=TopRight}"><Ellipse Width="6" Height="6" Fill="{StaticResource TextDimBrush}" /></RadioButton>
                                                    <RadioButton ToolTip="Left" IsChecked="{Binding Anchor, Converter={StaticResource EnumBool}, ConverterParameter=MiddleLeft}"><Ellipse Width="6" Height="6" Fill="{StaticResource TextDimBrush}" /></RadioButton>
                                                    <RadioButton ToolTip="Center" IsChecked="{Binding Anchor, Converter={StaticResource EnumBool}, ConverterParameter=Center}"><Ellipse Width="6" Height="6" Fill="{StaticResource TextDimBrush}" /></RadioButton>
                                                    <RadioButton ToolTip="Right" IsChecked="{Binding Anchor, Converter={StaticResource EnumBool}, ConverterParameter=MiddleRight}"><Ellipse Width="6" Height="6" Fill="{StaticResource TextDimBrush}" /></RadioButton>
                                                    <RadioButton ToolTip="Bottom left" IsChecked="{Binding Anchor, Converter={StaticResource EnumBool}, ConverterParameter=BottomLeft}"><Ellipse Width="6" Height="6" Fill="{StaticResource TextDimBrush}" /></RadioButton>
                                                    <RadioButton ToolTip="Bottom" IsChecked="{Binding Anchor, Converter={StaticResource EnumBool}, ConverterParameter=BottomCenter}"><Ellipse Width="6" Height="6" Fill="{StaticResource TextDimBrush}" /></RadioButton>
                                                    <RadioButton ToolTip="Bottom right" IsChecked="{Binding Anchor, Converter={StaticResource EnumBool}, ConverterParameter=BottomRight}"><Ellipse Width="6" Height="6" Fill="{StaticResource TextDimBrush}" /></RadioButton>
                                                </UniformGrid>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                                <Grid>
                                                    <TextBlock Text="Size" Foreground="{StaticResource TextDimBrush}" />
                                                    <TextBlock Style="{StaticResource ValueText}" Text="{Binding Width, Converter={StaticResource Pct}}" />
                                                </Grid>
                                                <Slider Minimum="0.02" Maximum="1" Value="{Binding Width}" Margin="0,2,0,6" />
                                                <Grid>
                                                    <TextBlock Text="Edge margin" Foreground="{StaticResource TextDimBrush}" />
                                                    <TextBlock Style="{StaticResource ValueText}" Text="{Binding Margin, Converter={StaticResource Pct}}" />
                                                </Grid>
                                                <Slider Minimum="0" Maximum="0.15" Value="{Binding Margin}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,10,0,0">
                                            <TextBlock Text="Opacity" Foreground="{StaticResource TextDimBrush}" />
                                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding Opacity, Converter={StaticResource Pct}}" />
                                        </Grid>
                                        <Slider Minimum="0.05" Maximum="1" Value="{Binding Opacity}" Margin="0,2,0,0" />

                                        <TextBlock Style="{StaticResource SectionHeader}" Text="TIMING" />
                                        <Border Style="{StaticResource Segments}">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton Style="{StaticResource SegmentedRadio}" GroupName="Show" Content="Always"
                                                             IsChecked="{Binding ShowMode, Converter={StaticResource EnumBool}, ConverterParameter=Always}" />
                                                <RadioButton Style="{StaticResource SegmentedRadio}" GroupName="Show" Content="Every few minutes"
                                                             IsChecked="{Binding ShowMode, Converter={StaticResource EnumBool}, ConverterParameter=Interval}" />
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Visibility="{Binding ShowMode, Converter={StaticResource EqVis}, ConverterParameter=Interval}">
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="Every (seconds)" />
                                                    <TextBox Text="{Binding IntervalSeconds, UpdateSourceTrigger=LostFocus}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="Show for (seconds)" />
                                                    <TextBox Text="{Binding DurationSeconds, UpdateSourceTrigger=LostFocus}" />
                                                </StackPanel>
                                            </Grid>
                                            <CheckBox Style="{StaticResource Toggle}" Content="Fade in and out" IsChecked="{Binding Fade}" />
                                            <TextBlock Style="{StaticResource Hint}" Text="Timed from the start of each recording - e.g. 'Follow @me' for 10 s every 5 minutes." />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ===================== REPLAY ===================== -->
                        <TabItem Header="Replay">
                            <ScrollViewer Style="{StaticResource TabScroll}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Style="{StaticResource SectionHeader}" Margin="0,4,0,0" Text="INSTANT REPLAY" />
                                        <CheckBox HorizontalAlignment="Right" IsChecked="{Binding S.ReplayEnabled}" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                               Text="Keeps the last moments in memory, always. Hit the hotkey after something great happens and it's saved - no need to have been recording." />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Keep the last" />
                                    <ComboBox ItemsSource="{Binding ReplayLengths}" SelectedItem="{Binding S.ReplaySeconds}" ItemStringFormat="{}{0} seconds" />
                                    <Border Margin="0,12,0,0" CornerRadius="8" Padding="12,10" Background="{StaticResource Bg2Brush}"
                                            Visibility="{Binding Rec.ReplayActive, Converter={StaticResource BoolVis}}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Fill="{StaticResource GoodBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Replay buffer running" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource Hint}" Text="{Binding Rec.ReplayInfo}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <Button Style="{StaticResource PrimaryButton}" Padding="12,6" Content="Save replay now" Command="{Binding SaveReplayCommand}" />
                                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Text="{Binding S.HotkeyReplay}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                                               Text="Uses the same encoder and settings as recordings. Memory use is roughly bitrate × length (e.g. 60 s at 50 Mbps ≈ 375 MB)." />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ===================== HOTKEYS ===================== -->
                        <TabItem Header="Hotkeys">
                            <ScrollViewer Style="{StaticResource TabScroll}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="170" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.Resources>
                                        <Style TargetType="ui:HotkeyBox" BasedOn="{StaticResource {x:Type ui:HotkeyBox}}">
                                            <Setter Property="Margin" Value="0,5" />
                                        </Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </Grid.Resources>
                                    <TextBlock Grid.Row="0" Text="Start / stop recording" />
                                    <ui:HotkeyBox Grid.Row="0" Grid.Column="1" Hotkey="{Binding S.HotkeyRecord}" />
                                    <TextBlock Grid.Row="1" Text="Pause / resume" />
                                    <ui:HotkeyBox Grid.Row="1" Grid.Column="1" Hotkey="{Binding S.HotkeyPause}" />
                                    <TextBlock Grid.Row="2" Text="Save replay" />
                                    <ui:HotkeyBox Grid.Row="2" Grid.Column="1" Hotkey="{Binding S.HotkeyReplay}" />
                                    <TextBlock Grid.Row="3" Text="Screenshot" />
                                    <ui:HotkeyBox Grid.Row="3" Grid.Column="1" Hotkey="{Binding S.HotkeyScreenshot}" />
                                    <TextBlock Grid.Row="4" Text="Add marker / chapter" />
                                    <ui:HotkeyBox Grid.Row="4" Grid.Column="1" Hotkey="{Binding S.HotkeyMarker}" />
                                    <TextBlock Grid.Row="5" Text="Mute / unmute mic" />
                                    <ui:HotkeyBox Grid.Row="5" Grid.Column="1" Hotkey="{Binding S.HotkeyMicMute}" />
                                    <TextBlock Grid.Row="6" Grid.ColumnSpan="2" Style="{StaticResource Hint}" Margin="0,12,0,0" x:Name="HotkeyStatus"
                                               Text="Hotkeys work everywhere, even inside fullscreen games. Click a box and press the new keys; Backspace clears." />
                                </Grid>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ===================== GENERAL ===================== -->
                        <TabItem Header="General">
                            <ScrollViewer Style="{StaticResource TabScroll}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="Save recordings to" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding S.OutputFolder, UpdateSourceTrigger=LostFocus}" />
                                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Padding="10,6" Content="Browse…" Click="BrowseFolder_Click" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="File name" />
                                    <TextBox Text="{Binding S.FileNameTemplate, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock Style="{StaticResource Hint}" Text="{}{source} {date} {time} {res} {fps} are filled in automatically." />

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Countdown before recording" />
                                    <ComboBox ItemsSource="{Binding Countdowns}" SelectedItem="{Binding S.CountdownSeconds}" ItemStringFormat="{}{0} seconds" />

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Start a new file every" />
                                    <ComboBox ItemsSource="{Binding SplitChoices}" SelectedItem="{Binding S.SplitEveryMinutes}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding StringFormat={}{0} minutes}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding}" Value="0">
                                                                    <Setter Property="Text" Value="Never (one file)" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Style="{StaticResource Hint}" Text="Seamless: every part starts on a keyframe, nothing is lost between files." />

                                    <TextBlock Style="{StaticResource SectionHeader}" Text="WHILE RECORDING" />
                                    <CheckBox Style="{StaticResource Toggle}" Content="Show floating recording HUD" IsChecked="{Binding S.ShowHud}" />
                                    <CheckBox Style="{StaticResource Toggle}" Content="Outline the recorded region" IsChecked="{Binding S.ShowRegionBorder}" />
                                    <CheckBox Style="{StaticResource Toggle}" Content="Keep Framelock out of recordings" IsChecked="{Binding S.HideAppFromCapture}" />
                                    <CheckBox Style="{StaticResource Toggle}" Content="Minimize to tray when recording starts" IsChecked="{Binding S.MinimizeWhileRecording}" />
                                    <CheckBox Style="{StaticResource Toggle}" Content="Live preview while recording" IsChecked="{Binding S.PreviewWhileRecording}" />
                                    <CheckBox Style="{StaticResource Toggle}" Content="Markers become chapters (+ YouTube chapter list)" IsChecked="{Binding S.SaveMarkers}" />
                                    <CheckBox Style="{StaticResource Toggle}" Content="Sound effects" IsChecked="{Binding S.PlaySounds}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Recorder priority" />
                                    <ComboBox ItemsSource="{Binding Priorities}" SelectedItem="{Binding S.Priority}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumText}}" /></DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBlock Style="{StaticResource SectionHeader}" Text="APP" />
                                    <CheckBox Style="{StaticResource Toggle}" Content="Closing the window keeps Framelock in the tray" IsChecked="{Binding S.CloseToTray}" />
                                    <CheckBox Style="{StaticResource Toggle}" Content="Start with Windows (in the tray)" x:Name="AutostartToggle" Click="Autostart_Click" />
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Style="{StaticResource GhostButton}" Padding="10,6" Content="Open logs" Click="OpenLogs_Click" />
                                        <Button Style="{StaticResource GhostButton}" Padding="10,6" Margin="8,0,0,0" Content="Overlay images" Click="OpenOverlayFolder_Click" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,14,0,0" x:Name="AboutText" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ===================== RECORDINGS ===================== -->
                        <TabItem Header="Recordings" x:Name="RecordingsTab">
                            <Grid Margin="0,0,10,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Style="{StaticResource Hint}" Margin="0" VerticalAlignment="Center" Text="{Binding Recordings.Summary}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource IconButton}" Width="30" Height="30" Padding="0" ToolTip="Refresh" Command="{Binding RefreshRecordingsCommand}">
                                            <TextBlock Style="{StaticResource Icon}" FontSize="13" Text="&#xE72C;" />
                                        </Button>
                                        <Button Style="{StaticResource IconButton}" Width="30" Height="30" Padding="0" ToolTip="Open recordings folder" Command="{Binding OpenFolderCommand}">
                                            <TextBlock Style="{StaticResource Icon}" FontSize="13" Text="&#xE838;" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <ListBox Grid.Row="1" x:Name="RecordingsList" ItemsSource="{Binding Recordings.Items}" Padding="0,0,0,12"
                                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                         MouseDoubleClick="RecordingsList_MouseDoubleClick" KeyDown="RecordingsList_KeyDown">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                            <Setter Property="Padding" Value="6" />
                                            <Setter Property="Margin" Value="0,0,0,4" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type ui:RecordingItem}">
                                            <Grid Background="Transparent" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                                <Grid.ContextMenu>
                                                    <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                        <MenuItem Header="Open" Command="{Binding OpenRecordingCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        <MenuItem Header="Fix audio…" Command="{Binding FixAudioCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        <MenuItem Header="Show in folder" Command="{Binding RevealRecordingCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        <Separator />
                                                        <MenuItem Header="Move to Recycle Bin" Command="{Binding RecycleRecordingCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    </ContextMenu>
                                                </Grid.ContextMenu>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="128" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="128" Height="72" CornerRadius="6" Background="{StaticResource Bg3Brush}" VerticalAlignment="Top">
                                                    <Grid>
                                                        <TextBlock Style="{StaticResource Icon}" FontSize="20" Foreground="{StaticResource TextMutedBrush}" Text="&#xE714;" />
                                                        <Border CornerRadius="6">
                                                            <Border.Background>
                                                                <ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill" />
                                                            </Border.Background>
                                                        </Border>
                                                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4" Padding="5,1" CornerRadius="4" Background="#CC0D0E12"
                                                                Visibility="{Binding HasDuration, Converter={StaticResource BoolVis}}">
                                                            <TextBlock Text="{Binding Duration}" FontSize="11" Foreground="{StaticResource TextBrush}" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                                    <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" Text="{Binding Meta}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Style="{StaticResource Hint}" Margin="0,1,0,0" Text="{Binding When}" TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                        <Button Style="{StaticResource GhostButton}" Padding="8,3" FontSize="12" IsEnabled="{Binding CanFixAudio}"
                                                                ToolTip="{Binding FixAudioTip}" ToolTipService.ShowOnDisabled="True"
                                                                Command="{Binding DataContext.FixAudioCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE9E9;" Margin="0,0,6,0" />
                                                                <TextBlock Text="Fix audio" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Style="{StaticResource GhostButton}" Padding="8,3" FontSize="12" Margin="6,0,0,0" Content="Open"
                                                                Command="{Binding DataContext.OpenRecordingCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                                        <Button Style="{StaticResource IconButton}" Width="28" Height="26" Padding="0" Margin="4,0,0,0" ToolTip="Show in folder"
                                                                Command="{Binding DataContext.RevealRecordingCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}">
                                                            <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE838;" />
                                                        </Button>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,0,20,60"
                                            Visibility="{Binding Recordings.IsEmpty, Converter={StaticResource BoolVis}}">
                                    <TextBlock Style="{StaticResource Icon}" FontSize="28" Foreground="{StaticResource TextMutedBrush}" Text="&#xE714;" />
                                    <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" FontWeight="SemiBold" Text="No recordings yet" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" TextAlignment="Center" TextWrapping="Wrap"
                                               Text="Finished videos show up here, newest first. Fix the game and mic balance with one click." />
                                </StackPanel>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
